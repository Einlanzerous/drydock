# Drydock prod daemon — systemd USER unit template (DRY-19).
#
# Do not install this file directly: deploy/install-prod.sh renders it
# (substituting __APP_DIR__ / __NODE__ / __PATH__) into
# ~/.config/systemd/user/drydock-daemon.service and (re)starts it.
#
# All config lives in __APP_DIR__/.env (the daemon's env.ts loads it from the
# checkout root) — the unit deliberately sets no DRYDOCK_* vars so prod config
# has exactly one home.
#
# To survive logout/reboot without an active session, enable lingering once:
#   sudo loginctl enable-linger $USER

[Unit]
Description=Drydock daemon (prod, port from .env — default 4318)
After=network-online.target
# NO start rate limit, and this is load-bearing since DRY-57.
#
# The daemon now takes Node's default exit on an uncaught exception, because
# sessions outlive it and a fresh daemon reattaches to them. systemd's default
# is 5 starts per 10s, and with RestartSec=2 a deterministic crash-at-boot burns
# that in about eight seconds — after which the unit sits in `failed` until
# somebody runs `systemctl --user reset-failed`. That is a WORSE state than the
# one this replaced: the agents are alive in their supervisors, and the only
# thing that can reach them is the process systemd has given up restarting.
#
# So: keep trying. A restart loop is noisy in the journal and costs nothing
# else, and every attempt is another chance to come back and re-adopt the
# sessions that are still sitting there waiting to be reached.
#
# IT BELONGS IN [Unit], NOT [Service], and the difference is silent. systemd
# keeps a compatibility alias for the OLD spellings there (StartLimitInterval=,
# StartLimitBurst=) but not for the Sec form, so `StartLimitIntervalSec=` under
# [Service] is dropped with an "Unknown key name" notice nobody reads and the
# unit keeps the default limit. Verified with `systemd-analyze verify` on
# systemd 255; check it there if this ever moves.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=__APP_DIR__/daemon
ExecStart=__NODE__ --import tsx src/index.ts
Restart=always
RestartSec=2
# THE ONE LINE THAT MAKES DRY-57 TRUE OF A DEPLOY (DRY-87).
#
# systemd's default is KillMode=control-group: a stop or restart SIGTERMs every
# process in the unit's cgroup. The supervisors are in there — `setsid` gives a
# process its own session, not its own cgroup, and cgroup membership is
# inherited across fork — and so is everything they spawned: `claude`, the
# login shells, their MCP servers. `install-prod.sh` ends in `systemctl --user
# restart`, so under the default EVERY deploy killed every live agent, which is
# the exact thing DRY-57 exists to prevent. It presented as a caveat about
# unlucky timing rather than as what happens every single time.
#
# `process` signals the main process only. The supervisors are left holding
# their PTYs for the daemon that comes back to re-adopt them, which is the whole
# design: the daemon is a client of its own sessions.
#
# NOT `mixed`, which is the tempting middle: it still SIGKILLs the whole cgroup
# once TimeoutStopSec expires, so it costs exactly the agent that is slow to
# exit — the one most likely to be mid-task.
#
# Measured on systemd 255 before trusting the deploy story: with the unit ALREADY
# RUNNING under the old default, rendering this line and running `daemon-reload`
# applies it to the running unit, so the `restart` that follows in install-prod.sh
# already spares the supervisors. The deploy that ships this fix is the first one
# to benefit from it; there is no one-time amnesty to arrange. The cost is a few
# journal lines per deploy — "Unit process N remains running after unit stopped"
# — which are the supervisors, and are the point.
KillMode=process
# Spawned agents and shells inherit this environment; keep the installing
# user's real PATH so `claude`, git, bun, etc. resolve as in a login shell.
# install-prod.sh sanitises it first: an entry under /run/user belongs to the
# shell that ran the deploy and is reaped with it (DRY-87), and this PATH is
# what `claude`, `git` and `bun` resolve through inside every session.
Environment=PATH=__PATH__

[Install]
WantedBy=default.target
