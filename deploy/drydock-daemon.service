# Drydock prod daemon — systemd USER unit template (DRY-19).
#
# Do not install this file directly: deploy/install-prod.sh renders it
# (substituting __APP_DIR__ / __NODE__ / __PATH__) into
# ~/.config/systemd/user/drydock-daemon.service and (re)starts it.
#
# All config lives in __APP_DIR__/.env (the daemon's env.ts loads it from the
# checkout root) — the unit deliberately sets no DRYDOCK_* vars so prod config
# has exactly one home.
#
# To survive logout/reboot without an active session, enable lingering once:
#   sudo loginctl enable-linger $USER

[Unit]
Description=Drydock daemon (prod, port from .env — default 4318)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=__APP_DIR__/daemon
ExecStart=__NODE__ --import tsx src/index.ts
Restart=always
RestartSec=2
# NO start rate limit, and this is load-bearing since DRY-57.
#
# The daemon now takes Node's default exit on an uncaught exception, because
# sessions outlive it and a fresh daemon reattaches to them. systemd's default
# is 5 starts per 10s, and with RestartSec=2 a deterministic crash-at-boot burns
# that in about eight seconds — after which the unit sits in `failed` until
# somebody runs `systemctl --user reset-failed`. That is a WORSE state than the
# one this replaced: the agents are alive in their supervisors, and the only
# thing that can reach them is the process systemd has given up restarting.
#
# So: keep trying. A restart loop is noisy in the journal and costs nothing
# else, and every attempt is another chance to come back and re-adopt the
# sessions that are still sitting there waiting to be reached.
StartLimitIntervalSec=0
# Spawned agents and shells inherit this environment; keep the installing
# user's real PATH so `claude`, git, bun, etc. resolve as in a login shell.
Environment=PATH=__PATH__

[Install]
WantedBy=default.target
