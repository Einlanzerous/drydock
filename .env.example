# Drydock daemon host config. Copy to `.env` (gitignored) and fill in.
# Real environment variables override these; `.env` is for convenience.

# --- Issue tracker (DRY-10) ---
# fixture (default, no creds) | switchyard | jira
DRYDOCK_TRACKER=switchyard
# Switchyard REST API base (no trailing slash, no /v1 — the provider adds it).
# The API listens on :4002; from the host use localhost (the `switchyard`
# hostname only resolves inside the docker network).
DRYDOCK_SWITCHYARD_URL=http://localhost:4002
DRYDOCK_SWITCHYARD_TOKEN=your_token_here
# Jira instead: site base URL + credentials. Cloud = email + API token
# (id.atlassian.com → Security → API tokens); Server/DC = personal access
# token alone, no email.
# DRYDOCK_JIRA_URL=https://yourco.atlassian.net
# DRYDOCK_JIRA_EMAIL=you@yourco.com
# DRYDOCK_JIRA_TOKEN=your_api_token
# Default project scope for the ticket list/search (DRY-30), comma-separated
# keys. STRONGLY recommended on a corporate tracker — unscoped, the sidebar
# pulls every open ticket in the instance (bounded only by a 2000-ticket
# backstop). The UI can add keys on top per browser. Backlog-status tickets
# are excluded from the pull by default; the sidebar's "backlog" toggle opts in.
# DRYDOCK_TRACKER_PROJECTS=SRE,SREREV,SREDESK

# --- Tracker caching (DRY-72) ---
# The sidebar polls every 20s per browser tab, and against a corporate Jira one
# pull runs 5.7-6s (paged list + a child-stats query spanning every status), so
# uncached this was a permanent ~30% duty cycle at the tracker per tab. The
# daemon now serves the list from memory and refreshes behind the response, so
# nothing here makes a client wait longer — it only bounds how old an answer is.
# How old the ticket list may get before a background refresh. 0 = no cache.
# DRYDOCK_TRACKER_CACHE_MS=20000
# Epic child counts (DRY-13) — the unbounded half, since that query spans every
# status. A completion ratio moves over days, so it's cached far longer.
# DRYDOCK_TRACKER_CHILD_STATS_CACHE_MS=300000
# Deadline on a single tracker HTTP request. Nothing propagates a client's
# abort, so without one a page-walk outlives the browser that asked for it.
# DRYDOCK_TRACKER_REQUEST_TIMEOUT_MS=20000

# --- Ticket-spawn repo mapping (DRY-9) ---
# A ticket's repo name resolves to <root>/<repo> as the spawn cwd.
# DRYDOCK_REPOS_ROOT=~/projects
# Per-repo overrides for repos that live elsewhere (comma-separated name=path):
# DRYDOCK_REPO_PATHS=construct-server=~/construct-server,imperium-loop=~/imperium-loop
# The DRY project has no repo_url, so its tickets resolve to repo "dry":
# DRYDOCK_REPO_PATHS=dry=~/projects/drydock
# Jira: a ticket's COMPONENT names its repo (a project is a team, DRY-31),
# slugged lowercase with spaces->dashes ("My Service" -> my-service); tickets
# without a component fall back to the lowercased project key. Use those slugs
# as the keys here. A multi-component ticket prefers a component listed in
# DRYDOCK_REPO_PATHS.
# DRYDOCK_REPO_PATHS=my-service=~/work/my-service,sre=~/work/sre-misc

# --- Worktree isolation (DRY-15) ---
# Ticket-spawned agents in a git repo get their own worktree on branch
# agent/<TICKET>, under this root, so concurrent agents don't clobber each other.
# DRYDOCK_WORKTREES_ROOT=~/.drydock/worktrees
# DRYDOCK_WORKTREES=0            # set 0 to disable — agents run in the repo cwd

# --- Autonomous runs (DRY-49) ---
# A run started from the ticket panel with "Run autonomously" gets a card on the
# rail instead of a window, and keeps its permission gates for an HOUR rather
# than the supervised 300s — the point being that a gate can wait out a meeting.
# When one does go unanswered the run is denied with a reason and ended, rather
# than left at a prompt nobody can see.
# DRYDOCK_AUTONOMOUS_PERMISSION_TIMEOUT_MS=3600000
#
# How much an unattended run may do without asking. This is the host's policy;
# the launch panel can override it per run, and leaving that picker on "Host
# default" means changing it here takes effect everywhere immediately.
#   manual       (default) every gated tool raises a Drydock gate. Safest, and
#                the most interruptive — a run touching twelve files asks twelve
#                times unless you hit "Always allow <Tool>" on the panel.
#   acceptEdits  file edits pass silently; Bash and WebFetch still gate. The
#                middle: the run is in its own worktree so edits are cheap to
#                review afterwards, while anything reaching OUT of it stops.
#   auto         nothing gates (same for bypassPermissions / dontAsk). The rail
#                becomes a progress display — it can still tell you a run
#                failed, but it will never ask you anything.
# DRYDOCK_AUTONOMOUS_PERMISSION_MODE=acceptEdits
#
# Every autonomous run writes a handoff document here when it ends — the durable
# record, since the run had no window and its scrollback dies with the daemon.
# DRYDOCK_RUNS_ROOT=~/.drydock/runs
#
# Optional. If set, the tracker comment a finished run posts includes a link
# back to the shell. Unset by default and simply left out: the daemon knows its
# own address but not where the shell is served from, and a guessed URL in a
# permanent ticket comment is worse than no URL.
# DRYDOCK_SHELL_URL=http://your-host:5321

# --- Clearing finished sessions (DRY-60) ---
# A session that ends STAYS on the desk, because a terminal state has to survive
# until somebody sees it — a run that failed at 3am must still be there at 9am.
# The cost is that seeing it was the only thing that cleared it, one window and
# one rail card at a time, so a couple of dozen autonomous runs finishing is a
# couple of dozen dismissals over overlapping windows.
#
# So a run that ended CLEANLY now clears itself after this long, and the header
# grows a "Clear finished" button that does the lot at once. Never a failed run,
# by either route: clearing must not be how you lose a failure.
#
# This is a delay the SHELL applies (the daemon goes on listing every exited
# session, so a browser that wasn't open still finds them). It counts only while
# the tab is actually in front of you and it restarts when you come back, so
# it's five minutes of somebody being able to read the card rather than five
# minutes of wall clock. The window you have focused is never taken, and both
# the card and the window frame show the countdown before it happens.
# Set 0 to turn the sweep off entirely and dismiss everything by hand.
# DRYDOCK_CLEAR_FINISHED_AFTER_MS=300000
#
# Worth knowing per tier: with DRYDOCK_DATABASE_URL set, a swept session is
# still in session history and comes back as a resumable tombstone. Without one
# its scrollback was the only copy there ever was, and the shell says so at the
# moment the sweep first costs you something.

# --- Workspace state (DRY-28) ---
# The daemon owns your desktop arrangement, so it follows YOU rather than the
# browser that drew it (localStorage is kept only as an offline mirror).
#
# THIS IS THE KNOB THAT MOVES A HOST BETWEEN DRYDOCK'S TWO TIERS. Both are real
# modes; they are aimed at different things (see the README).
#
# Unset = a JSON file, no database, nothing to install. The default, and a
# complete Drydock: sessions survive disconnects, scrollback replays, autonomous
# runs work. It is how you try this out. What it can't do is be queried, be
# shared by a second daemon, or retain anything about sessions that have ended.
# DRYDOCK_STATE_FILE=~/.drydock/state-<port>.json
#
# Set DRYDOCK_DATABASE_URL to keep state in Postgres instead — the recommended
# path for a host you depend on: multi-machine agentic work, or solo work meant
# to survive weeks. The URL is the ONLY difference between a central database
# and a container on this laptop:
#   central   point it at your server (see the form below)
#   local     handled for you by DRYDOCK_DB_LOCAL, further down
# Note what this does NOT gate: how long a session lives. That is a property of
# how this host runs its PTYs, and it is identical in both tiers — whatever
# survives, survives without a database.
# The daemon migrates its own schema on first use, and never fails to start
# because a database is unreachable — it degrades and the shell keeps its
# mirror, because window positions must never cost you a running agent. It also
# recovers without a restart — needing to bounce a host full of running agents
# to get a window position saved would be absurd (DRY-58).
# DRYDOCK_DATABASE_URL=postgres://<user>:<password>@<host>:5432/drydock
#
# `bun run up` (and `bun run db:up`) start the local Postgres container in
# deploy/compose.db.yml, GENERATE a password into this file on first use, and
# write the matching DRYDOCK_DATABASE_URL next to it — so every way of starting
# the daemon agrees where state lives. Nothing is committed and there is no
# shared default to inherit. 5433 because a dev box's other Postgres usually
# already holds 5432.
# DRYDOCK_DB_LOCAL=1
# DRYDOCK_DB_PORT=5433
# DRYDOCK_DB_PASSWORD is written here for you; set it yourself only if you want
# a specific value, and do it BEFORE the first `db:up` — Postgres reads it once,
# at initdb, so changing it later needs the volume dropped (db:down -- -v).
#
# Namespaces saved state. A constant until DRY-27 brings accounts — and NOT a
# security boundary: the daemon has no auth, so this only stops two people
# sharing one host from overwriting each other's desk.
# DRYDOCK_OWNER=local
#
# Which saved desk THIS daemon owns. Defaults to <hostname>-<port>, because a
# desk is a set of window ids belonging to this daemon's sessions: two daemons
# sharing one row don't share a desk, they fight over it (each drops the
# other's windows as dead and saves the result). That matters most in the setup
# this is for — a desktop and a laptop pointed at one central Postgres, both on
# :4317. Set the SAME value on two daemons to deliberately share.
# DRYDOCK_WORKSPACE=my-desk
# DRYDOCK_STATE_MAX_BYTES=1048576

# --- Logging & crash containment (DRY-45) ---
# Session/client lifecycle and crash traces, appended to a file that outlives the
# process (stdout is the terminal that launched the daemon — long gone by the
# time anyone asks why their agents vanished). Rotates one generation.
# Default path carries the port — ~/.drydock/daemon-4317.log in dev,
# daemon-4318.log in prod — so a second daemon on a spare port (the documented
# way to verify changes) doesn't interleave into the same file.
# DRYDOCK_LOG_FILE=~/.drydock/daemon-<port>.log   # empty disables the file sink
# DRYDOCK_LOG_MAX_BYTES=8388608
# An uncaught exception used to kill every live PTY, so the daemon logged it and
# stayed up. Since DRY-57 sessions outlive the daemon and a restart reattaches to
# them, so this now takes Node's default exit. Set 0 for the old wedged-but-
# attached posture.
# DRYDOCK_EXIT_ON_UNCAUGHT=0

# --- Session history (DRY-56) ---
# What a database buys, and the line Drydock's two tiers are drawn on. With
# DRYDOCK_DATABASE_URL set, every session is recorded — ticket, repo, branch,
# worktree, when it ended and why — so a window whose PTY is gone comes back as
# a tombstone you can resume from instead of vanishing. Without one, the file
# store keeps no history and the shell SAYS so at the moment a session is lost,
# rather than leaving an absent tombstone to look like a lost session.
#
# Nothing to do with DRY-57's process durability, which is free in both tiers.
# Retention applies both bounds; a running session is never a prune candidate.
# DRYDOCK_SESSION_HISTORY_DAYS=30
# DRYDOCK_SESSION_HISTORY_MAX=500

# --- Session durability (DRY-57) ---
# Each PTY is held by its own detached supervisor process, not by the daemon, so
# restarting (or crashing) the daemon no longer destroys live agents. This is
# where their sockets and the index a restarted daemon rediscovers them from
# live. Per-port for the same reason the log and state files are: a throwaway
# daemon on a spare port must not adopt the dev daemon's live agents.
#
# Set it explicitly to move a daemon's sessions with it when its port changes.
# Keep the path SHORT — it holds unix sockets, and the whole absolute path has
# to fit in ~100 bytes (the daemon refuses a spawn with a clear message if not).
# DRYDOCK_SESSIONS_DIR=~/.drydock/sessions-<port>

# --- Other (optional) ---
# DRYDOCK_HOST=0.0.0.0          # set 127.0.0.1 to lock the daemon to localhost
# DRYDOCK_PORT=4317             # prod (DRY-19) runs 4318 so dev and prod coexist
# DRYDOCK_SHELL=/usr/bin/zsh    # login shell for `+ shell` sessions (defaults to $SHELL)
