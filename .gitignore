node_modules/
dist/
*.log
.drydock/
.DS_Store
*.tsbuildinfo
.env
.env.*
!.env.example

# Machine-local npm registry override (DRY-68). Behind a corporate mirror this
# file is what stops `bun install` inheriting a jfrog registry from ~/.npmrc, so
# it exists on some hosts and not others — committing one developer's would
# point everyone else's install at a registry they can't reach.
.npmrc

# Ad-hoc playwright install for scripts/verify (see its README)
scripts/verify/node_modules/
scripts/verify/package*.json

# drift.sh writes a throwaway migration here for ~20s (scripts/verify/README.md).
# Real migration input, so a run killed mid-flight must not be able to leave it
# committable — the next daemon to boot would apply it.
daemon/src/state/migrations/*_probe.sql
